{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reality-engine.local/schemas/reality_benchmark/result.schema.json",
  "title": "Reality Engine benchmark scenario result",
  "description": "One scenario's scorecard as produced by benchmarks.reality_benchmark.scorer.score_scenario.",
  "type": "object",
  "required": ["benchmark_version", "scenario_id", "ground_truth_available", "verdict", "weighted_score", "coverage", "categories", "gates", "metric_results"],
  "properties": {
    "benchmark_version": {"type": "string"},
    "scenario_id": {"type": "string", "pattern": "^[0-9]{3}$"},
    "run_id": {"type": "string"},
    "engine_commit": {"type": "string"},
    "ground_truth_available": {"type": "boolean"},
    "verdict": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
    "weighted_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Over measured weighted categories only; null when nothing was measured."},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1, "description": "Share of the category weight that was actually measured."},
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "weight", "metrics", "measured", "passed", "coverage", "score"],
        "properties": {
          "name": {"type": "string"}, "weight": {"type": "number", "minimum": 0},
          "metrics": {"type": "integer", "minimum": 0}, "measured": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0},
          "coverage": {"type": "number", "minimum": 0, "maximum": 1}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate_id", "name", "status", "reasons"],
        "properties": {
          "gate_id": {"type": "string"}, "name": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "PROVISIONAL", "BLOCKED", "NOT_APPLICABLE", "NOT_RUN"]},
          "reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "metric_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_id", "value", "unit", "threshold", "status", "sample_count", "confidence_interval_95", "breakdown", "reason"],
        "properties": {
          "metric_id": {"type": "string"},
          "value": {"type": ["number", "null"]},
          "unit": {"type": "string"},
          "threshold": {"type": ["object", "null"], "properties": {"op": {"enum": [">=", "<=", "=="]}, "value": {"type": "number"}}},
          "status": {"enum": ["PASS", "FAIL", "PROVISIONAL", "BLOCKED", "NOT_APPLICABLE", "NOT_RUN"]},
          "sample_count": {"type": "integer", "minimum": 0},
          "confidence_interval_95": {
            "type": "object", "required": ["lower", "upper"],
            "properties": {"lower": {"type": ["number", "null"]}, "upper": {"type": ["number", "null"]}}
          },
          "breakdown": {"type": "object"},
          "reason": {"type": ["string", "null"]}
        }
      }
    },
    "artifacts": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "format": "uri"}}}
  }
}
